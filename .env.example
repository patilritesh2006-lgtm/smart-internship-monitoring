# ==============================================================================
# Smart Internship Management & Monitoring System (SIMMS)
# Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE DEPLOYMENT:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual production .env files or secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' in live staging/production environments.
# In 'production' mode, default/weak JWT secrets will cause server startup to abort.
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC JWT SECRET KEY
# ------------------------------------------------------------------------------
# MUST be a cryptographically random, high-entropy secret (min 32 characters).
# Generate using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# or:
#   openssl rand -hex 32
SECRET_KEY=replace-with-a-cryptographically-random-64-char-hex-string-before-deploying

# Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL Recommended for Production)
# ------------------------------------------------------------------------------
# In production, use managed PostgreSQL for ACID compliance and institutional concurrency.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://simms_user:change_this_password@postgres-db.internal:5432/smart_internship_db

# (For local zero-config testing only: sqlite:///./smart_internship.db)

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (FASTAPI BACKEND)
# ------------------------------------------------------------------------------
# Comma-separated list of fully-qualified public frontend domains allowed to make API requests.
# Do NOT include wildcard '*' or localhost in public production.
CORS_ORIGINS=https://internship.university.edu,https://simms.university.edu

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION (NEXT.JS)
# ------------------------------------------------------------------------------
# Public API base URL accessed by the user's browser.
# Note: Next.js reads NEXT_PUBLIC_* variables at build time and client runtime.
NEXT_PUBLIC_API_URL=https://api.internship.university.edu/api
